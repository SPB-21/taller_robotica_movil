<?xml version="1.0"?>
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="rueda_radio" value="0.05"/>
  <xacro:property name="rueda_ancho" value="0.03"/>
  <xacro:property name="rueda_masa" value="0.1"/>
  <xacro:property name="separacion_ruedas" value="0.25"/>
  <xacro:property name="caster_radio" value="0.02"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.004167" ixy="0.0" ixz="0.0" iyy="0.008333" iyz="0.0" izz="0.010833"/>
    </inertial>
  </link>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry></visual>
    <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0000179" ixy="0" ixz="0" iyy="0.0000179" iyz="0" izz="0.0000225"/></inertial>
  </link>
  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.1 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.02 0.05 0.02"/></geometry></visual>
    <collision><geometry><box size="0.02 0.05 0.02"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="0.00000483" ixy="0" ixz="0" iyy="0.00000133" iyz="0" izz="0.00000483"/></inertial>
  </link>
  <joint name="joint_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.16 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="joint_camera_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <xacro:macro name="rueda" params="prefijo y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
      </collision>
      <inertial>
        <mass value="${rueda_masa}"/>
        <inertia ixx="${rueda_masa*(3*rueda_radio*rueda_radio+rueda_ancho*rueda_ancho)/12}" ixy="0.0" ixz="0.0"
                 iyy="${rueda_masa*(3*rueda_radio*rueda_radio+rueda_ancho*rueda_ancho)/12}" iyz="0.0"
                 izz="${0.5*rueda_masa*rueda_radio*rueda_radio}"/>
      </inertial>
    </link>

    <joint name="joint_rueda_${prefijo}" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <origin xyz="0 ${y_signo * separacion_ruedas/2} -0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="caster" params="prefijo x">
    <link name="caster_${prefijo}">
      <visual>
        <geometry><sphere radius="${caster_radio}"/></geometry>
        <material name="gris"><color rgba="0.5 0.5 0.5 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radio}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="${0.4*0.05*caster_radio*caster_radio}" ixy="0.0" ixz="0.0"
                 iyy="${0.4*0.05*caster_radio*caster_radio}" iyz="0.0"
                 izz="${0.4*0.05*caster_radio*caster_radio}"/>
      </inertial>
    </link>
    <joint name="joint_caster_${prefijo}" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefijo}"/>
      <origin xyz="${x} 0 ${-0.07 + caster_radio}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="caster_${prefijo}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:rueda prefijo="izq" y_signo="1"/>
  <xacro:rueda prefijo="der" y_signo="-1"/>
  <xacro:caster prefijo="frontal" x="0.12"/>
  <xacro:caster prefijo="trasero" x="-0.12"/>


  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

      <left_joint>joint_rueda_izq</left_joint>
      <right_joint>joint_rueda_der</right_joint>

      <wheel_separation>${separacion_ruedas}</wheel_separation>
      <wheel_radius>${rueda_radio}</wheel_radius>

      <odom_publish_frequency>30</odom_publish_frequency>

      <topic>/model/mi_robot/cmd_vel</topic>
      <odom_topic>/model/mi_robot/odometry</odom_topic>

      <tf_topic>/model/mi_robot/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

    </plugin>
  </gazebo>


  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">

      <always_on>1</always_on>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.15</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>

    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camara" type="camera">
      <always_on>1</always_on>
      <topic>image_raw</topic>
      <update_rate>30</update_rate>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>10</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
